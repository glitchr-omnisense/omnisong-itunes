{
    "name": "omnisong/itunes",
    "type": "library",
    "description": "Omnisong iTunes: an artist's albums and tracks with their 30-second previews and artwork, through the iTunes Search API - no key.",
    "keywords": ["music", "itunes", "apple-music", "preview", "omnisong"],
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnisong": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnisong\\Itunes\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnisong\\Itunes\\Tests\\": "Tests/"}
    },
    "extra": {"omnisense": {"policy": "policy.json"}},
    "config": {"sort-packages": true}
}
